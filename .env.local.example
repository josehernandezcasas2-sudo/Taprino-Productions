# Copy this file to .env.local and fill in real values.
# None of these cost anything to obtain — Stripe test mode and a random secret are both free.

# From https://dashboard.stripe.com/test/apikeys
SSTRIPE_SECRET_KEY=your_stripe_secret_key_here

# The Price ID for your "Cipher Circle" monthly membership.
# Create it at https://dashboard.stripe.com/test/products
STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx

# From https://dashboard.stripe.com/test/webhooks after you add an endpoint
# pointing at https://yourdomain.com/api/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Any long random string — this signs the membership cookie so it can't be forged.
# Generate one with: openssl rand -hex 32
COOKIE_SIGNING_SECRET=replace-this-with-a-long-random-string

# Optional. Leave blank to use Google's public IMA sample ad tag while you test.
# Replace with your own Google Ad Manager VAST tag once you're ready to run real ads.
NEXT_PUBLIC_AD_TAG_URL=
