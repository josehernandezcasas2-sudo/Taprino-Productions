# Copy this file to .env.local and fill in real values.
# None of these cost anything to obtain — Stripe test mode and a random secret are both free.

# From https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# Optional fallback. Membership plans are read from Stripe Products that
# carry metadata tier=standard|premium|sponsor (lib/membershipPlans.js);
# until those exist, this one price is offered as "Premium".
STRIPE_PRICE_ID=

# From https://dashboard.stripe.com/test/webhooks after you add an endpoint
# pointing at https://yourdomain.com/api/webhook (use the exact host the site
# answers on — Stripe doesn't follow redirects)
STRIPE_WEBHOOK_SECRET=

# Second endpoint at the same URL for Stripe Connect: "Listen to events on
# Connected accounts", event account.updated. It has its own signing secret.
STRIPE_CONNECT_WEBHOOK_SECRET=

# Optional. Leave blank to use Google's public IMA sample ad tag while you test.
# Replace with your own Google Ad Manager VAST tag once you're ready to run real ads.
NEXT_PUBLIC_AD_TAG_URL=

# Optional. Powers the "email everyone who wishlisted this series" send
# when you publish a new episode (see /api/notify-series-drop). Free at
# https://resend.com. Without it, that endpoint just skips sending instead
# of emailing — fine for testing, not for real notifications.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Studio Tapa TV <hello@studiotapatv.site>

# Optional. If set, newsletter signups write into this Notion database
# instead of a local JSON file — a natural fit if you're already running
# an Artist Hub in Notion. Get the token from notion.so/my-integrations;
# the database ID is the 32-character string in that database's URL.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Primary system for what wins the homepage hero slot — real view counts,
# not the manual `featured` flag (which only exists as a fallback if this
# ever briefly goes unconfigured or has an outage). See the README's "Set
# up view tracking" section for the full steps. Free tier at
# https://upstash.com (500K commands/month, no card required).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required to call /api/notify-series-drop (emails everyone who wishlisted a
# series when you publish a new episode). Any long random string — generate
# one with: openssl rand -hex 32
ADMIN_NOTIFY_SECRET=

# Clerk — real login (email + password), replacing the old magic-link system.
# Free up to 10,000 monthly active users. Get these from clerk.com after
# creating an application (API Keys page in the Clerk dashboard).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase — the content database (episodes, series, creator submissions).
# Auth stays entirely with Clerk; Supabase is only ever talked to from the
# server, never the browser, so only the service role key is needed — not
# the anon/publishable key. Get both from Settings -> API in your Supabase
# project dashboard.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Stream — needed for creator video uploads to go directly to
# Cloudflare rather than through our own server (which can't handle large
# video payloads). Account ID and API token: dashboard.cloudflare.com ->
# your account -> Stream. Customer code: the subdomain in any existing
# Stream video's URL, e.g. the XXXXXXXX in customer-XXXXXXXX.cloudflarestream.com.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=

# Bunny.net Stream — a second video provider (lib/bunnyUpload.js),
# alongside Cloudflare above, for uploads/variety. Library ID and API key:
# dash.bunny.net -> Stream -> your library -> API. Pull zone host: same
# library's Playback/Embed tab, ends in .b-cdn.net. Token security key
# (only needed for signed/premium playback, optional otherwise): the pull
# zone's Security -> Token Authentication tab -> turn it on -> copy the key.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_PULL_ZONE_HOST=
BUNNY_STREAM_TOKEN_SECURITY_KEY=

# Vercel's cron jobs (vercel.json: content expiry daily, Creator Share
# payouts on the 1st) send `Authorization: Bearer <CRON_SECRET>`; set the
# same value here and in Vercel so /api/cron/* accepts them. Any long
# random string.
CRON_SECRET=

# Studio money (/admin/money): on the sweep day the cron emails what can
# leave Stripe for the bank (or what's in the way) to this address.
# Defaults to SITE.contactEmail.
STUDIO_MONEY_NOTIFY_EMAIL=

# Private beta (lib/privateBetaRules.js): "on" locks the site behind
# /welcome for anyone signed out (the legal pages, /apply, /about and
# /contact stay open) and makes the app show its door. Pair it with
# Clerk → Restrictions → Sign-up mode: Restricted, so only invited
# addresses (/admin/invites) can create an account. Leave blank to open
# the site. PRIVATE_BETA_NOTIFY_EMAIL gets a note per invite request
# (defaults to SITE.contactEmail); PRIVATE_BETA_WELCOME_URL is where
# Clerk's invitation link lands (defaults to the www host's /welcome).
PRIVATE_BETA=
PRIVATE_BETA_NOTIFY_EMAIL=
PRIVATE_BETA_WELCOME_URL=
